{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaredrive",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "video"
    }
  ]
}
